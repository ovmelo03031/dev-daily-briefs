---
import { Image } from 'astro:assets';
import { SITE_TITLE, CATEGORIES, isLivingCategory, type Category } from '../consts';
import { getCategoryLabel } from '../utils/categoryCopy';
import { getNavLabel } from '../utils/navCopy';
import { getLangFromPath, localizePath, stripLangFromPath } from '../utils/i18n';
import { Icon } from 'astro-icon/components';
import LangToggle from './LangToggle.astro';
import BriefsMenu from './BriefsMenu.astro';
import MobileNav from './MobileNav.astro';
import CategoryIcon from './CategoryIcon.astro';
import logo from '../assets/brand/logo-wordmark-transparent.png';

const lang = getLangFromPath(Astro.url.pathname);
const basePath = stripLangFromPath(Astro.url.pathname);

const livingCategories = (Object.keys(CATEGORIES) as Category[]).filter((slug) => isLivingCategory(slug));
const isCategoryActive = (slug: Category) => basePath === `/${slug}/` || basePath.startsWith(`/${slug}/`);
const isTopicsActive = basePath === '/tags/' || basePath.startsWith('/tags/');
const topicsLabel = getNavLabel('topics', lang);
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-sm">
	<nav class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-3">
		<div class="flex min-w-0 items-center gap-2">
			<a href={localizePath('/', lang)} class="mr-2 flex shrink-0 items-center no-underline hover:opacity-80 transition-opacity" aria-label={SITE_TITLE}>
				<Image src={logo} alt={SITE_TITLE} height={36} densities={[1, 2]} loading="eager" class="h-8 w-auto sm:h-10" />
			</a>

			<div class="hidden sm:flex items-center gap-2">
				<BriefsMenu lang={lang} basePath={basePath} />
				{livingCategories.map((slug) => {
				const cat = CATEGORIES[slug];
				const label = getCategoryLabel(slug, lang);
				const active = isCategoryActive(slug);
				return (
					<a
						href={localizePath(`/${slug}/`, lang)}
						class="nav-link"
						class:list={{ 'nav-link-active': active }}
						aria-current={active ? 'page' : undefined}
					>
						<CategoryIcon category={slug} width={14} height={14} style={`color: ${cat.accent}`} />
							<span>{label}</span>
						</a>
					);
				})}
			</div>
		</div>

		<div class="flex items-center gap-1">
			<div class="hidden sm:flex items-center gap-1">
				<a
					href="/tags/"
					class="nav-link"
					class:list={{ 'nav-link-active': isTopicsActive }}
					aria-current={isTopicsActive ? 'page' : undefined}
				>
					<Icon name="lucide:tags" width={14} height={14} style="color: var(--color-accent)" />
					<span>{topicsLabel}</span>
				</a>
			</div>
			<div class="ml-1 border-l border-[var(--color-border)] pl-1 sm:ml-2 sm:pl-2">
				<LangToggle />
			</div>
			<MobileNav lang={lang} basePath={basePath} class="sm:hidden" />
		</div>
	</nav>
</header>

<script>
	// Keep the header's three disclosure widgets (Daily Briefs dropdown,
	// language toggle, mobile sheet) mutually exclusive, and close them on
	// outside click / Escape — matching LangToggle's own listener pattern.
	const DROPDOWN_IDS = ['briefs-menu', 'lang-toggle', 'mobile-nav'];

	function closeOthers(openId: string) {
		for (const id of DROPDOWN_IDS) {
			if (id === openId) continue;
			document.getElementById(id)?.removeAttribute('open');
		}
	}

	function closeAll() {
		for (const id of DROPDOWN_IDS) {
			document.getElementById(id)?.removeAttribute('open');
		}
	}

	function updateMobileTriggerLabel(details: HTMLDetailsElement) {
		const trigger = details.querySelector('summary[data-label-menu]');
		if (!trigger) return;
		const menuLabel = trigger.getAttribute('data-label-menu');
		const closeLabel = trigger.getAttribute('data-label-close');
		trigger.setAttribute('aria-label', (details.open ? closeLabel : menuLabel) ?? '');
	}

	function initHeaderDropdowns() {
		for (const id of DROPDOWN_IDS) {
			const el = document.getElementById(id) as HTMLDetailsElement | null;
			if (!el) continue;
			el.addEventListener('toggle', () => {
				if (el.open) closeOthers(id);
				if (id === 'mobile-nav') updateMobileTriggerLabel(el);
			});
		}

		document.addEventListener('click', (e) => {
			for (const id of DROPDOWN_IDS) {
				const el = document.getElementById(id) as HTMLDetailsElement | null;
				if (!el || !el.open) continue;
				if (!(e.target as Element).closest(`#${id}`)) {
					el.removeAttribute('open');
				}
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			closeAll();
		});
	}

	initHeaderDropdowns();
	document.addEventListener('astro:after-swap', initHeaderDropdowns);
</script>
