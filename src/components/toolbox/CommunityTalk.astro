---
import { pickLang, type Lang } from '../brief/pickLang';

interface CommunityItem {
	id: string;
	date: string;
	platform: 'hn' | 'reddit';
	community: string;
	title: string;
	url: string;
	points: number;
	comments: number;
	takeaway: Parameters<typeof pickLang>[0];
}

interface Props {
	items: CommunityItem[];
	lang: Lang;
}

const { items, lang } = Astro.props;
const sorted = [...items].sort((a, b) => (b.points + b.comments) - (a.points + a.comments));

const PLATFORM_LABELS: Record<CommunityItem['platform'], string> = {
	hn: 'HN',
	reddit: 'Reddit',
};

const COPY: Record<Lang, { title: string; subtitle: string; points: string; comments: string }> = {
	en: { title: 'Community talk', subtitle: 'What communities are discussing this week.', points: 'pts', comments: 'comments' },
	es: { title: 'Charla de la comunidad', subtitle: 'De qué habla la comunidad esta semana.', points: 'pts', comments: 'comentarios' },
	fr: { title: 'Discussions de la communauté', subtitle: "Ce dont discute la communauté cette semaine.", points: 'pts', comments: 'commentaires' },
};

const copy = COPY[lang];
---

<section class="toolbox-section community-talk" data-anchor="community-talk">
	<div class="toolbox-section-head">
		<h2>{copy.title}</h2>
		<p class="toolbox-section-subtitle">{copy.subtitle}</p>
	</div>
	<div class="community-list">
		{sorted.map((item) => (
			<a href={item.url} target="_blank" rel="noopener" class="community-item">
				<div class="community-item-meta">
					<span class={`platform-badge platform-${item.platform}`}>{PLATFORM_LABELS[item.platform]}</span>
					<span class="community-name">{item.community}</span>
					<span class="community-date">{item.date}</span>
				</div>
				<h3 class="community-title">{item.title}</h3>
				<p class="community-takeaway">{pickLang(item.takeaway, lang)}</p>
				<div class="community-stats">
					<span>{item.points} {copy.points}</span>
					<span>{item.comments} {copy.comments}</span>
				</div>
			</a>
		))}
	</div>
</section>
